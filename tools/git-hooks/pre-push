#!/usr/bin/env bash
# The free local gate (docs/GIT_HOOKS.md section 2): refuse a direct push to
# the default branch, then run the structural-scan lane in local mode.
# Only definite findings block; a missing scanner warns through.
# Escape hatch, named and scoped to this hook: SKIP_PUSH_GATE=1 git push
[ -n "${SKIP_PUSH_GATE:-}" ] && { echo "pre-push: SKIP_PUSH_GATE set; gate skipped" >&2; exit 0; }
root="$(git rev-parse --show-toplevel)" || exit 0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: direct push to ${remote_ref#refs/heads/} refused -- open a PR" >&2
      exit 1 ;;
  esac
done
timeout 600 bash "$root/tools/quality/scan.sh" local
rc=$?
[ "$rc" = 124 ] && { echo "pre-push: scan timed out; pushing -- CI remains the gate" >&2; exit 0; }
exit "$rc"
